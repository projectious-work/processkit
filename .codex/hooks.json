{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "aibox-agent-signal question --harness codex --hook-input",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "aibox-agent-signal working --harness codex --hook-input >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "aibox-agent-signal working --harness codex --hook-input >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "aibox-agent-signal idle --harness codex --hook-input",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "aibox-agent-signal idle --harness codex --hook-input >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "aibox-agent-signal done --harness codex --hook-input >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "aibox-agent-signal working --harness codex --hook-input >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ]
  }
}
