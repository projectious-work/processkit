{
  "hooks": {
    "Notification": [
      {
        "_aibox_attention_managed": true,
        "hooks": [
          {
            "command": "aibox-agent-signal question --harness claude --hook-input",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog"
      }
    ],
    "PermissionRequest": [
      {
        "_aibox_attention_managed": true,
        "hooks": [
          {
            "command": "aibox-agent-signal question --harness claude --hook-input",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "_aibox_attention_managed": true,
        "hooks": [
          {
            "command": "aibox-agent-signal idle --harness claude --hook-input",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "_aibox_attention_managed": true,
        "hooks": [
          {
            "command": "aibox-agent-signal done --harness claude --hook-input",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "StopFailure": [
      {
        "_aibox_attention_managed": true,
        "hooks": [
          {
            "command": "aibox-agent-signal error --harness claude --hook-input",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "_aibox_attention_managed": true,
        "hooks": [
          {
            "command": "aibox-agent-signal working --harness claude --hook-input",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
