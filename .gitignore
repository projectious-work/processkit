# ── Project-specific ─────────────────────────────────────────────────────────
# Add your project-specific ignore patterns here.

# temporary holding area for the post-v0.5.1 aibox re-scaffolding
# experiment — see _pre-aibox-context/README.md
_pre-aibox-context/

# temporary holding area (pre-memory-reset stash)
_backup/


# ── aibox generated ────────────────────────────────────────────────────────
# Files generated by aibox — do not remove these entries.
.aibox-local.toml
.devcontainer/Dockerfile
.devcontainer/docker-compose.yml
.devcontainer/devcontainer.json
.aibox-home/
.root/
.aibox-version
.aibox/
.aibox-backup/
.aibox-env/

# ── OS generated files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
.Trash-*

# ── Editor / IDE ─────────────────────────────────────────────────────────────
*.swp
*.swo
*~
.idea/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
site/


# aibox generated

context/private/

.aibox-local.env
.mcp.json
.cursor/mcp.json
.gemini/settings.json
.codex/config.toml
.continue/mcpServers/

.claude/settings.local.json

# Harness skill projections are local, except the company standard skills
# generated by .standards/standards.py.
.agents/skills/*
!.agents/skills/standard-*/
.codex/hooks.json

# Rust build output for the installer workspace.
installer/target/

.latex-cache/

# Local integration-test sandboxes may contain generated credentials.
tmp/

# Local release signing keys are never repository content.
.release-keys/

context/.cache/
context/.state/
context/**/private/
context/templates/aibox-home/
