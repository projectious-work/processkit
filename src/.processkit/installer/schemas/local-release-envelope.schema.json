{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "release",
    "archive",
    "descriptor",
    "provenance",
    "signing",
    "installerAssets"
  ],
  "properties": {
    "apiVersion": {
      "const": "processkit.projectious.work/local-release/v1alpha1"
    },
    "kind": {"const": "LocalRelease"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "processkit"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size", "topLevelDirectory"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 1},
        "topLevelDirectory": {"type": "string", "minLength": 1}
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {
          "const": ".processkit/installer/release-descriptor.json"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "generatedForTag"],
      "properties": {
        "file": {"const": "PROVENANCE.toml"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "generatedForTag": {"type": "string", "minLength": 1}
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "keyId": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "installerAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256", "target", "size"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "target": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
