{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "source", "python", "uv",
    "dependencyResolution", "servers", "dependencyProfiles",
    "aggregateSha256"
  ],
  "properties": {
    "apiVersion": {
      "const": "processkit.projectious.work/python-runtime/v1alpha1"
    },
    "kind": {"const": "PythonRuntimePolicy"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "scope"],
      "properties": {
        "root": {"const": "context/skills"},
        "scope": {"const": "shipped-release"}
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires"],
      "properties": {"requires": {"const": ">=3.10"}}
    },
    "uv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "requiredFeatures"],
      "properties": {
        "command": {"const": "uv"},
        "requiredFeatures": {
          "type": "array",
          "contains": {"const": "pep-723-script-metadata"},
          "minContains": 1,
          "uniqueItems": true
        }
      }
    },
    "dependencyResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coldOfflineSupported", "requiresPreparedCache",
        "resolvedVersionsLocked", "lockFile", "lockSha256",
        "hashesRequired"
      ],
      "properties": {
        "coldOfflineSupported": {"const": false},
        "requiresPreparedCache": {"const": true},
        "resolvedVersionsLocked": {"const": true},
        "lockFile": {
          "const": ".processkit/runtime/python-requirements.lock"
        },
        "lockSha256": {"$ref": "#/$defs/sha256"},
        "hashesRequired": {"const": true}
      }
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/server"}
    },
    "dependencyProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    },
    "aggregateSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "headerSha256", "profileSha256",
        "requiresPython", "dependencies"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "headerSha256": {"$ref": "#/$defs/sha256"},
        "profileSha256": {"$ref": "#/$defs/sha256"},
        "requiresPython": {"type": "string", "minLength": 1},
        "dependencies": {"$ref": "#/$defs/dependencies"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256", "requiresPython", "dependencies", "serverPaths"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "requiresPython": {"type": "string", "minLength": 1},
        "dependencies": {"$ref": "#/$defs/dependencies"},
        "serverPaths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
