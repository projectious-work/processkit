{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "source", "detection", "migration"],
  "properties": {
    "apiVersion": {"const": "processkit.projectious.work/installer/v1alpha1"},
    "kind": {"const": "CompatibilityManifest"},
    "id": {"type": "string", "pattern": "^v0-release-[0-9]+-[0-9]+-[0-9]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "releaseVersion"],
      "properties": {
        "project": {"const": "processkit"},
        "releaseVersion": {"type": "string", "pattern": "^v0\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "anchors"],
      "properties": {
        "mode": {"const": "exact-release"},
        "anchors": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "reason"],
      "properties": {
        "disposition": {"enum": ["evidence-only", "unsupported"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
