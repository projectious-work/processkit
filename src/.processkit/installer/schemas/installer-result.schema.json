{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "apiVersion", "status", "changes", "conflicts", "warnings", "errors"
  ],
  "properties": {
    "apiVersion": {
      "const": "processkit.projectious.work/installer/v1alpha1"
    },
    "status": {
      "enum": [
        "planned", "conflict", "invalid", "installed", "updated",
        "uninstalled", "recovered", "verified", "drifted"
      ]
    },
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    },
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/problem"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/problem"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/problem"}
    },
    "state": {"type": "object"},
    "checked": {"type": "integer", "minimum": 0},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "change": {
      "oneOf": [
        {
          "type": "object",
          "required": ["count"],
          "properties": {"count": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "component", "destination", "kind", "operation",
            "ownership", "sourceSha256"
          ],
          "properties": {
            "component": {"type": "string"},
            "destination": {"type": "string"},
            "kind": {"type": "string"},
            "operation": {"type": "string"},
            "ownership": {"type": "string"},
            "sourceSha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "problem": {
      "type": "object",
      "required": ["code", "message", "path"],
      "properties": {
        "actualSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "code": {"type": "string"},
        "expectedSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "message": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
