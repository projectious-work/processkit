{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "path", "ownership", "applied"],
  "properties": {
    "kind": {"enum": ["create", "replace", "remove"]},
    "path": {"type": "string", "minLength": 1},
    "ownership": {"enum": ["managed-three-way", "preserve-user", "shared"]},
    "oldSha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "newSha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "stagedPath": {"type": ["string", "null"]},
    "backupPath": {"type": ["string", "null"]},
    "createdParents": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "applied": {"type": "boolean"}
  }
}
