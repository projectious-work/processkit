{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/processkit/v1/ontology-extension.schema.json",
  "title": "processkit ontology extension",
  "description": "Published extension metaschema. One OntologyExtension item declares a namespace, its owner, and the concepts, discriminators, relation types, and content kinds it adds. An OntologyExtension has no metadata.namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "processkit.projectious.work/v1"
    },
    "kind": {
      "const": "OntologyExtension"
    },
    "metadata": {
      "$ref": "resource-metadata.schema.json",
      "not": {
        "required": [
          "namespace"
        ]
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "namespaceOwner"
      ],
      "anyOf": [
        {
          "required": [
            "concepts"
          ]
        },
        {
          "required": [
            "relationTypes"
          ]
        },
        {
          "required": [
            "contentKinds"
          ]
        }
      ],
      "properties": {
        "namespace": {
          "$ref": "ontology-registry.schema.json#/$defs/extensionNamespace"
        },
        "namespaceOwner": {
          "description": "Accountable person, role, or team that owns the namespace.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "concepts": {
          "description": "Added concepts and discriminators (class D).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/concept"
          }
        },
        "relationTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relationType"
          }
        },
        "contentKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contentKind"
          }
        }
      }
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "class",
        "side",
        "description",
        "schema"
      ],
      "properties": {
        "name": {
          "$ref": "ontology-registry.schema.json#/$defs/conceptName"
        },
        "class": {
          "enum": [
            "T",
            "P",
            "D",
            "C"
          ]
        },
        "side": {
          "enum": [
            "definition",
            "instance"
          ]
        },
        "sideRule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "parent": {
          "$ref": "ontology-registry.schema.json#/$defs/conceptName"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ontology-registry.schema.json#/$defs/conceptName"
          }
        },
        "schema": {
          "description": "JSON Schema (Draft 2020-12) of the concept's spec, or of the fragment for class T and instance concepts.",
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "D"
              }
            }
          },
          "then": {
            "required": [
              "parent"
            ]
          },
          "else": {
            "not": {
              "required": [
                "parent"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "C"
              }
            }
          },
          "then": {
            "required": [
              "parts"
            ]
          },
          "else": {
            "not": {
              "required": [
                "parts"
              ]
            }
          }
        }
      ]
    },
    "relationType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction",
        "subject",
        "target",
        "cardinality",
        "inverse",
        "scope"
      ],
      "properties": {
        "name": {
          "$ref": "ontology-registry.schema.json#/$defs/relationTypeName"
        },
        "direction": {
          "enum": [
            "directed",
            "symmetric"
          ]
        },
        "subject": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ontology-registry.schema.json#/$defs/endpoint"
          }
        },
        "target": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ontology-registry.schema.json#/$defs/endpoint"
          }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "ontology-registry.schema.json#/$defs/conceptName"
          }
        },
        "cardinality": {
          "enum": [
            "one-to-one",
            "many-to-one",
            "one-to-many",
            "many-to-many"
          ]
        },
        "inverse": {
          "$ref": "ontology-registry.schema.json#/$defs/relationTypeName"
        },
        "scope": {
          "type": "boolean"
        }
      }
    },
    "contentKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "concept",
        "schema"
      ],
      "properties": {
        "kind": {
          "description": "Envelope kind name of the added content kind.",
          "$ref": "ontology-registry.schema.json#/$defs/conceptName"
        },
        "concept": {
          "description": "Definition-side concept (published or added) the kind realizes.",
          "$ref": "ontology-registry.schema.json#/$defs/conceptName"
        },
        "schema": {
          "description": "Closed JSON Schema (Draft 2020-12) of the kind's spec.",
          "type": "object"
        }
      }
    }
  }
}
