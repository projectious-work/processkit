{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/processkit/v1/status.schema.json",
  "title": "processkit derived item status",
  "description": "Derived facts processkit reports as the status member of an item. Single-item results (CLI get TYPE NAME and describe, MCP get and explain) carry the full object; list and context entries (CLI get TYPE and get context, MCP list and get_context) carry $defs/listStatus. Authored content never contains status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation",
    "digest",
    "source",
    "provenance",
    "references",
    "uncommitted"
  ],
  "properties": {
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "diagnostics"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "diagnostics": {
          "description": "Diagnostics for this item; each has the diagnostic shape of cli@v1.",
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "digest": {
      "description": "SHA-256 of the bytes of the source file that holds the item's envelope.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "POSIX path of that file, relative to the root of the repository that holds it.",
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^/|(^|/)\\.\\.(/|$)|\\\\"
          }
        }
      }
    },
    "provenance": {
      "description": "Provenance of the item (inheritance@v1 PK-INH-015).",
      "$ref": "https://schemas.projectious.work/processkit/v1/inheritance/provenance.schema.json"
    },
    "references": {
      "description": "Every typed reference in the item's spec, in document order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "ref",
          "resolved"
        ],
        "properties": {
          "pointer": {
            "description": "JSON pointer (RFC 6901) of the reference within the item.",
            "type": "string",
            "pattern": "^(/[^/]*)*$"
          },
          "ref": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          },
          "origin": {
            "description": "Present when the target is inherited: the target's provenance.origin (inheritance@v1).",
            "$ref": "https://schemas.projectious.work/processkit/v1/inheritance/provenance.schema.json#/$defs/location"
          }
        }
      }
    },
    "uncommitted": {
      "description": "True when a source file of the item is untracked or differs from HEAD (repository-storage@v1 PK-STORE-062).",
      "type": "boolean"
    }
  },
  "$defs": {
    "listStatus": {
      "description": "The status member of list and get_context entries: the attribution facts of content-kinds@v1 PK-CONT-003 without diagnostics or references.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "digest",
        "source",
        "provenance",
        "uncommitted"
      ],
      "properties": {
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "valid",
                "invalid"
              ]
            }
          }
        },
        "digest": {
          "$ref": "#/properties/digest"
        },
        "source": {
          "$ref": "#/properties/source"
        },
        "provenance": {
          "$ref": "#/properties/provenance"
        },
        "uncommitted": {
          "$ref": "#/properties/uncommitted"
        }
      }
    }
  }
}
