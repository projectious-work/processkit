{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/processkit/v1/role-binding.schema.json",
  "title": "processkit access role binding",
  "description": "Grants one Role to subjects in the binding's namespace and its descendant namespaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "processkit.projectious.work/v1"
    },
    "kind": {
      "const": "RoleBinding"
    },
    "metadata": {
      "$ref": "resource-metadata.schema.json"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "subjects"
      ],
      "properties": {
        "role": {
          "description": "Role name, optionally namespace-qualified as <namespace>/<name>; an unqualified name resolves in the binding's namespace or an ancestor.",
          "type": "string",
          "pattern": "^([a-z][a-z0-9]*(?:-[a-z0-9]+)*/)?[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "User",
                  "Group"
                ]
              },
              "name": {
                "description": "Identifier asserted by the authenticator, e.g. an e-mail, OIDC subject, certificate CN, or group claim.",
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "expires": {
          "description": "Optional time after which the binding grants nothing.",
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
