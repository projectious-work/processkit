{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/processkit/v1/role.schema.json",
  "title": "processkit access role",
  "description": "A named, additive set of permissions. A Role grants nothing until a RoleBinding binds it to subjects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "processkit.projectious.work/v1"
    },
    "kind": {
      "const": "Role"
    },
    "metadata": {
      "$ref": "resource-metadata.schema.json"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kinds",
        "verbs"
      ],
      "properties": {
        "kinds": {
          "description": "Resource kinds, or [\"*\"].",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(\\*|[A-Z][A-Za-z0-9]*)$"
          },
          "uniqueItems": true
        },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "get",
              "list",
              "search",
              "create",
              "update",
              "transition",
              "delete",
              "*"
            ]
          },
          "uniqueItems": true
        },
        "names": {
          "description": "Restricts the rule to these resource names.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "selector": {
          "description": "Label selector the resource must match, in processkit selector syntax.",
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
