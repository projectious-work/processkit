{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/processkit/v1/standard.schema.json",
  "title": "processkit governance standard",
  "description": "A structured, versioned rule set a company, team, or project defines for its own work. Disclosure levels are listed in content-kinds@v1 interfaces.yaml (levels.Standard).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "processkit.projectious.work/v1"
    },
    "kind": {
      "const": "Standard"
    },
    "metadata": {
      "$ref": "resource-metadata.schema.json"
    },
    "spec": {
      "description": "A complete standard, or (overrides.effect amend) only an amending override of an inherited standard.",
      "if": {
        "type": "object",
        "required": [
          "overrides"
        ],
        "properties": {
          "overrides": {
            "type": "object",
            "required": [
              "effect"
            ],
            "properties": {
              "effect": {
                "const": "amend"
              }
            }
          }
        }
      },
      "then": {
        "$ref": "#/$defs/amendSpec"
      },
      "else": {
        "$ref": "#/$defs/fullSpec"
      }
    }
  },
  "$defs": {
    "standardId": {
      "description": "metadata.name of another Standard, optionally namespace-qualified as <namespace>/<name>.",
      "type": "string",
      "pattern": "^([a-z][a-z0-9]*(?:-[a-z0-9]+)*/)?[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ruleId"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "description": "Narrows the rule to these profiles; omitted means the standard's applicability.",
          "type": "array",
          "items": {
            "$ref": "content-common.schema.json#/$defs/profile"
          },
          "uniqueItems": true
        },
        "section": {
          "description": "Section id that explains this rule in detail.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "final": {
          "description": "When true, downstream overrides cannot change this rule.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "description": "Typed reference <kind>/<name> or <kind>/<namespace>/<name>.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*/([a-z][a-z0-9]*(?:-[a-z0-9]+)*/)?[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "fullSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "version",
        "status",
        "owner",
        "summary",
        "triggers",
        "applicability",
        "rules"
      ],
      "properties": {
        "title": {
          "$ref": "content-common.schema.json#/$defs/title"
        },
        "version": {
          "$ref": "content-common.schema.json#/$defs/semver"
        },
        "status": {
          "$ref": "content-common.schema.json#/$defs/lifecycleStatus"
        },
        "owner": {
          "$ref": "content-common.schema.json#/$defs/owner"
        },
        "summary": {
          "$ref": "content-common.schema.json#/$defs/summary"
        },
        "triggers": {
          "$ref": "content-common.schema.json#/$defs/triggers"
        },
        "applicability": {
          "$ref": "content-common.schema.json#/$defs/applicability"
        },
        "rules": {
          "description": "Level-1 normative rules, in order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "sections": {
          "description": "Level-2 detail, retrievable one section at a time.",
          "type": "array",
          "items": {
            "$ref": "content-common.schema.json#/$defs/section"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standardId"
          },
          "uniqueItems": true
        },
        "alwaysOn": {
          "description": "When true, the rules join the level-0 connection briefing.",
          "type": "boolean",
          "default": false
        },
        "final": {
          "description": "When true, downstream repositories cannot override this standard (inheritance@v1 PK-INH-013).",
          "type": "boolean",
          "default": false
        },
        "overrides": {
          "$ref": "content-common.schema.json#/$defs/replaceOverride"
        },
        "decisions": {
          "$ref": "content-common.schema.json#/$defs/decisions"
        }
      }
    },
    "amendSpec": {
      "description": "An amending override (content-kinds@v1 PK-STD-006): the effective standard is the overridden upstream standard with ruleLevels applied and addRules appended. The spec holds nothing but overrides.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overrides"
      ],
      "properties": {
        "overrides": {
          "$ref": "#/$defs/amendOverride"
        }
      }
    },
    "amendOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "name",
        "version",
        "reason",
        "effect"
      ],
      "properties": {
        "upstream": {
          "description": "Upstream name from processkit.toml (inheritance@v1).",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/standardId"
        },
        "version": {
          "description": "Version of the overridden upstream standard.",
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "description": "amend: add rules, change rule levels, or both.",
          "const": "amend"
        },
        "addRules": {
          "description": "Rules appended, in order, after the upstream rules. Each id must not exist upstream.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "ruleLevels": {
          "description": "New levels for upstream rules, each named by rule id.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "level"
            ],
            "properties": {
              "rule": {
                "$ref": "#/$defs/ruleId"
              },
              "level": {
                "$ref": "#/$defs/level"
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "addRules"
          ]
        },
        {
          "required": [
            "ruleLevels"
          ]
        }
      ]
    },
    "ruleId": {
      "description": "Stable rule identifier, unique within the standard.",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "level": {
      "enum": [
        "MUST",
        "MUST NOT",
        "SHOULD",
        "SHOULD NOT",
        "MAY"
      ]
    }
  }
}
